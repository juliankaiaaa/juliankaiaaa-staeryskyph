# Copy to .env and fill in. Both values come from Supabase:
# Project Settings > API. The anon key is public, so it may be in the browser.
#
# VITE_USE_MOCK_API unset or true -> the browser-only demo, no Supabase needed
# VITE_USE_MOCK_API=false         -> the live Supabase project below
VITE_USE_MOCK_API=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
